# 统一行尾：仓库内一律 LF，检出时按平台规则还原
* text=auto eol=lf

# Windows 脚本必须 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell 脚本必须 LF
*.sh text eol=lf

# 二进制，禁止任何转换
*.bin  binary
*.elf  binary
*.o    binary
*.sym  binary
*.gbf  binary
*.pyc  binary
*.png  binary
*.jpg  binary
*.pdf  binary
*.ttf  binary
*.otf  binary
*.node binary
